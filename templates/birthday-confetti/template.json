{
  "schemaVersion": 1,
  "key": "birthday-confetti",
  "version": 1,
  "name": "Confetti Night",
  "description": "Gold and confetti on deep navy.",
  "eventTypes": ["birthday"],
  "tags": ["party", "bold"],
  "sortOrder": 2,
  "minRendererVersion": 1,
  "spec": {
    "canvas": { "width": 1080, "height": 1920 },
    "fonts": [
      { "family": "Pacifico", "weight": 400, "url": "fonts/pacifico/Pacifico-Regular.ttf" },
      { "family": "Poppins", "weight": 400, "url": "fonts/poppins/Poppins-Regular.ttf" },
      { "family": "Poppins", "weight": 600, "url": "fonts/poppins/Poppins-SemiBold.ttf" }
    ],
    "background": { "color": "#1B1F3B" },
    "layers": [
      { "id": "c-1", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 90, "y": 70, "w": 26, "h": 64 }, "rotation": 25, "radius": 6, "fill": "#FFD43B" },
      { "id": "c-2", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 260, "y": 150, "w": 26, "h": 64 }, "rotation": -35, "radius": 6, "fill": "#FF6B6B" },
      { "id": "c-3", "type": "shape", "role": "decoration", "shape": "ellipse", "frame": { "x": 430, "y": 60, "w": 36, "h": 36 }, "fill": "#4DABF7" },
      { "id": "c-4", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 600, "y": 120, "w": 26, "h": 64 }, "rotation": 60, "radius": 6, "fill": "#69DB7C" },
      { "id": "c-5", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 790, "y": 60, "w": 26, "h": 64 }, "rotation": -15, "radius": 6, "fill": "#DA77F2" },
      { "id": "c-6", "type": "shape", "role": "decoration", "shape": "ellipse", "frame": { "x": 950, "y": 170, "w": 30, "h": 30 }, "fill": "#FFD43B" },
      { "id": "c-7", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 120, "y": 1800, "w": 26, "h": 64 }, "rotation": -40, "radius": 6, "fill": "#4DABF7" },
      { "id": "c-8", "type": "shape", "role": "decoration", "shape": "ellipse", "frame": { "x": 330, "y": 1840, "w": 34, "h": 34 }, "fill": "#FF6B6B" },
      { "id": "c-9", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 560, "y": 1810, "w": 26, "h": 64 }, "rotation": 30, "radius": 6, "fill": "#FFD43B" },
      { "id": "c-10", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 760, "y": 1830, "w": 26, "h": 64 }, "rotation": -60, "radius": 6, "fill": "#69DB7C" },
      { "id": "c-11", "type": "shape", "role": "decoration", "shape": "ellipse", "frame": { "x": 960, "y": 1790, "w": 36, "h": 36 }, "fill": "#DA77F2" },
      {
        "id": "host", "type": "text",
        "frame": { "x": 80, "y": 260, "w": 920, "h": 90 },
        "text": "{{details.hostName}} invites you to",
        "style": {
          "fontFamily": "Poppins", "fontSize": 40, "minFontSize": 28, "color": "#E9ECEF",
          "align": "center", "verticalAlign": "middle", "maxLines": 1
        }
      },
      {
        "id": "photo", "type": "image",
        "frame": { "x": 390, "y": 400, "w": 300, "h": 300 },
        "src": "{{media.photoUrl}}", "fit": "cover",
        "clip": { "shape": "circle" },
        "border": { "width": 10, "color": "#FFD43B" },
        "visibleIf": "media.photoUrl"
      },
      {
        "id": "title", "type": "text",
        "frame": { "x": 60, "y": 760, "w": 960, "h": 330 },
        "text": "{{event.personName}}'s {{event.age|ordinal}} Birthday",
        "visibleIf": "event.age",
        "style": {
          "fontFamily": "Pacifico", "fontSize": 110, "minFontSize": 60, "color": "#FFD43B",
          "align": "center", "verticalAlign": "middle", "lineHeight": 1.15, "maxLines": 2
        }
      },
      {
        "id": "title-no-age", "type": "text",
        "frame": { "x": 60, "y": 760, "w": 960, "h": 330 },
        "text": "{{event.personName}}'s Birthday",
        "visibleIf": "!event.age",
        "style": {
          "fontFamily": "Pacifico", "fontSize": 110, "minFontSize": 60, "color": "#FFD43B",
          "align": "center", "verticalAlign": "middle", "lineHeight": 1.15, "maxLines": 2
        }
      },
      { "id": "divider", "type": "shape", "role": "decoration", "shape": "rect", "frame": { "x": 390, "y": 1120, "w": 300, "h": 4 }, "fill": "#FFD43B" },
      {
        "id": "when", "type": "text",
        "frame": { "x": 80, "y": 1170, "w": 920, "h": 160 },
        "text": "{{details.date|date:EEEE, d MMMM}}\n{{details.time|time}}",
        "style": {
          "fontFamily": "Poppins", "fontSize": 54, "minFontSize": 36, "fontWeight": 600, "color": "#FFFFFF",
          "align": "center", "verticalAlign": "middle", "lineHeight": 1.3, "maxLines": 2
        }
      },
      {
        "id": "where", "type": "text",
        "frame": { "x": 80, "y": 1350, "w": 920, "h": 180 },
        "text": "{{details.venue.name}}\n{{details.venue.address}}",
        "style": {
          "fontFamily": "Poppins", "fontSize": 40, "minFontSize": 28, "color": "#DEE2E6",
          "align": "center", "verticalAlign": "middle", "lineHeight": 1.3, "maxLines": 3
        }
      },
      {
        "id": "description", "type": "text",
        "frame": { "x": 100, "y": 1545, "w": 880, "h": 130 },
        "text": "{{details.description}}",
        "visibleIf": "details.description",
        "style": {
          "fontFamily": "Poppins", "fontSize": 34, "minFontSize": 24, "color": "#CED4DA",
          "align": "center", "verticalAlign": "middle", "lineHeight": 1.3, "maxLines": 3
        }
      },
      {
        "id": "rsvp", "type": "text",
        "frame": { "x": 80, "y": 1690, "w": 920, "h": 80 },
        "text": "RSVP {{details.rsvp.phone}} by {{details.rsvp.deadline|date:d MMM}}",
        "visibleIf": "details.rsvp.deadline",
        "style": {
          "fontFamily": "Poppins", "fontSize": 32, "minFontSize": 24, "color": "#FFD43B",
          "align": "center", "verticalAlign": "middle", "maxLines": 1
        }
      }
    ]
  }
}
