# Copy to .env for `npm run start:dev` (see src/config/env.ts for validation rules)
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27018/invite
WEB_APP_ORIGIN=http://localhost:8080
# Dev-only value. Real environments read it from Secrets Manager. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
# Proxies in front of the API (prod behind ALB: 1)
TRUST_PROXY_HOPS=0
# Template assets (fonts, images): local nginx in compose; prod: https://cdn.<domain>
ASSET_BASE_URL=http://localhost:8081
# User media. Locally: the compose `s3` service (SeaweedFS, S3-compatible). Prod: the media bucket via the ECS task role,
# no S3_ENDPOINT, and MEDIA_BASE_URL=https://cdn.<domain>.
S3_BUCKET=invite-media
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
MEDIA_BASE_URL=http://localhost:9000/invite-media
# The local S3 stand-in's dev login (docker/s3.json). Never set these in AWS: the task role provides credentials.
AWS_ACCESS_KEY_ID=s3-dev
AWS_SECRET_ACCESS_KEY=s3-dev-only-secret
